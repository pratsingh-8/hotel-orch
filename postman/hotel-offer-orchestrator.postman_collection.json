        {
          "name": "2. Delhi with A down -> B-only results + degraded header",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Takes ~3.5s: Temporal retries Supplier A 3 times (500ms, 1s backoff) before giving up.",
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"X-Degraded-Suppliers = Supplier A\", () => pm.expect(pm.response.headers.get(\"X-Degraded-Suppliers\")).to.eql(\"Supplier A\"));",
                  "pm.test(\"only Supplier B offers\", () => pm.response.json().forEach(x => pm.expect(x.supplier).to.eql(\"Supplier B\")));"
                ]
              }
            }
          ]
        },

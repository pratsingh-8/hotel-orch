PORT=3000
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Base URL the Temporal worker uses to reach the mock suppliers (served by the API process)
SUPPLIER_BASE_URL=http://localhost:3000
CACHE_TTL_SECONDS=300
# Start a supplier in "down" state (useful for failure simulation)
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false

{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Hotels",
      "item": [
        {
          "name": "Delhi - deduped best offers",
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const h = pm.response.json();",
                  "pm.test(\"no duplicate names\", () => pm.expect(new Set(h.map(x=>x.name.toLowerCase())).size).to.eql(h.length));",
                  "pm.test(\"Holtin -> Supplier B @ 5340\", () => { const x = h.find(i=>i.name===\"Holtin\"); pm.expect(x.price).to.eql(5340); pm.expect(x.supplier).to.eql(\"Supplier B\"); });",
                  "pm.test(\"Radison -> Supplier A @ 5900\", () => { const x = h.find(i=>i.name===\"Radison\"); pm.expect(x.price).to.eql(5900); pm.expect(x.supplier).to.eql(\"Supplier A\"); });",
                  "pm.test(\"Ibis tie -> higher commission (B)\", () => { const x = h.find(i=>i.name===\"Ibis Central\"); pm.expect(x.supplier).to.eql(\"Supplier B\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delhi - price range 5000-9000 (Redis filter)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=9000",
              "host": [
                "{{baseUrl}}"

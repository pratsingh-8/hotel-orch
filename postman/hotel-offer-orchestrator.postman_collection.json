          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const h = pm.response.json();",
                  "pm.test(\"all within range\", () => h.forEach(x => pm.expect(x.price).to.be.within(5000, 9000)));",
                  "pm.test(\"expected hotels\", () => pm.expect(h.map(x=>x.name)).to.have.members([\"Holtin\",\"Radison\",\"Leela Inn\"]));"
                ]
              }
            }
          ]
        },
